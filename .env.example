# Configurações do Telegram
# Obtenha o token criando um bot com @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# ID do chat onde as notificações serão enviadas
# Use @userinfobot para descobrir seu chat_id
TELEGRAM_CHAT_ID=123456789

# Configurações de Proxy (OPCIONAL - para bypass de bloqueio de IP)
# Deixe vazio se não usar proxy
# Formato sem autenticação:
#PROXY_HTTP=http://proxy.exemplo.com:8080
#PROXY_HTTPS=https://proxy.exemplo.com:8080

# Formato com autenticação:
#PROXY_HTTP=http://proxy.exemplo.com:8080
#PROXY_HTTPS=https://proxy.exemplo.com:8080
#PROXY_USERNAME=seu_usuario
#PROXY_PASSWORD=sua_senha

# Múltiplos proxies (rotação automática):
#PROXY_1=http://proxy1.com:8080|https://proxy1.com:8080
#PROXY_2=http://proxy2.com:8080|https://proxy2.com:8080|user|pass

# Configurações opcionais
# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Diretório de downloads
DOWNLOADS_DIR=downloads

# Timeout padrão para requisições (segundos)
REQUEST_TIMEOUT=30

# Delay entre requisições ao mesmo site (segundos)
RATE_LIMIT_DELAY=2

# Número máximo de retentativas em caso de falha
MAX_RETRIES=3
